@using CarManagerAPI.ViewModels.Cars;
@model List<IndexVM>;

<table>
	<tr>
		<td>№</td>
		<td>Name</td>
		<td>Brand</td>
		<td>Model</td>
		<td>Engine</td>
		<td>HP? amount</td>
		<td>Price</td>
		<td>Colour</td>
		<td>Mileage</td>
		<td>Year</td>
	</tr>
	@foreach(var car in Model){
		<tr>
			<td>@car.Id</td>
			<td>@car.Name</td>
			<td>@car.Brand</td>
			<td>@car.Model</td>
			<td>@car.EngineType</td>
			<td>@car.HPamount</td>
			<td>@car.Price</td>
			<td>@car.color</td>
			<td>@car.mileage</td>
			<td>@car.year</td>
		</tr>
	}
	
</table>