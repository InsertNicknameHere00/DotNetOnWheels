@using CarManagerAPI.ViewModels.Cars;
@model List<CarsVM>;

<table>
	<tr>
		<td>№</td>
		<td>Brand</td>
		<td>Model</td>
		<td>Engine</td>
		<td>HP? amount</td>
		<td>Price</td>
		<td>Colour</td>
		<td>Mileage</td>
		<td>Year</td>
	</tr>
	@foreach (var car in Model)
	{
		<tr>
			<td>@car.Id</td>
			<td>@car.Brand</td>
			<td>@car.Model</td>
			<td>@car.EngineType</td>
			<td>@car.HPamount</td>
			<td>@car.Price</td>
			<td>@car.color</td>
			<td>@car.Mileage</td>
			<td>@car.Year</td>
		</tr>
	}
	
</table>